# APNs configuration
env APN_KEY_PATH=/path/to/AuthKey.p8   # .p8 key file path
env APN_KEY_ID=YOUR_KEY_ID             # Key ID from Apple Developer
env APN_TEAM_ID=YOUR_TEAM_ID           # Team ID from Apple Developer
env APN_BUNDLE_ID=com.example.app      # App bundle identifier
env APN_PRODUCTION=false               # true=production, false=sandbox

# MQTT broker configuration
env MQTT_BROKER_URL=mqtt://broker.example.com
env MQTT_USERNAME=
env MQTT_PASSWORD=

# HTTP server port
env PORT=3000